# Ponto de partida para a VM:   cp .env.vm.example .env
# Depois:                       docker compose up -d --build
#
# Diferenças em relação ao .env.example (computador):
#   - não sobe o MinIO: as fotos vão para o armazenamento da organização;
#   - HTTPS com domínio: o Caddy emite e renova o certificado sozinho;
#   - duas instâncias da API;
#   - opcional: banco gerenciado no lugar do Postgres na VM.

# --- Endereço público --------------------------------------------------------
# Com domínio (o DNS precisa apontar para a VM e as portas 80 e 443 estar abertas):
SITE_ADDRESS=leilao.exemplo.com
PORTA_PUBLICA=80
PORTA_HTTPS=443
COOKIE_SEGURO=true
# Sem domínio, só HTTP pelo IP: troque as quatro linhas acima por
#   SITE_ADDRESS=:80
#   PORTA_PUBLICA=8080
#   PORTA_HTTPS=8443
#   COOKIE_SEGURO=false

# --- Banco -------------------------------------------------------------------
# Postgres na própria VM (padrão). Use só letras e números na senha.
POSTGRES_PASSWORD=troque-esta-senha
# Banco gerenciado: descomente as três linhas e o serviço `db` deixa de subir.
#COMPOSE_FILE=docker-compose.yml:docker-compose.gerenciado.yml
#DATABASE_URL=postgres://usuario:senha@host-do-provedor:5432/leilao
#DB_SSL=verificar

# --- Armazenamento de fotos (RF07) -----------------------------------------
# S3 da AWS: S3_ENDPOINT vazio. Outro serviço compatível: informe o endpoint.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_BUCKET=nome-do-bucket-da-equipe
S3_CRIAR_BUCKET=false
AWS_REGION=us-east-1
# Deixe as chaves vazias para usar o perfil da instância.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Sessão (RF02) -----------------------------------------------------------
SESSAO_INATIVIDADE_SEGUNDOS=7200
SESSAO_MAXIMO_SEGUNDOS=86400

# --- Limites do leilão (RF05 / RF06) ----------------------------------------
ANTECEDENCIA_MIN_SEGUNDOS=30
ANTECEDENCIA_MAX_SEGUNDOS=2592000
DURACAO_MIN_SEGUNDOS=60
DURACAO_MAX_SEGUNDOS=604800
FOTOS_MIN=3
FOTOS_MAX=8
FOTO_TAMANHO_MAX_BYTES=5242880

# --- Prorrogação (RF15) ------------------------------------------------------
PRORROGACAO_JANELA_SEGUNDOS=120
PRORROGACAO_MAXIMO_SEGUNDOS=1800

# --- Nível 2 -----------------------------------------------------------------
LANCE_INTERVALO_MIN_MS=500
EDICAO_BLOQUEIO_SEGUNDOS=1800

# --- Operação ----------------------------------------------------------------
API_REPLICAS=2
WORKER_REPLICAS=1
WORKER_INTERVALO_MS=500
LOG_LEVEL=info
# Protege GET /api/metricas: quem coleta envia "Authorization: Bearer <token>".
METRICAS_TOKEN=troque-este-token
