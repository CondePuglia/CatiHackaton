# Única porta de entrada: serve as telas e encaminha /api e /socket.io para a API.
# SITE_ADDRESS=:80 serve em HTTP; com um domínio (ex.: leilao.exemplo.com) o Caddy
# emite o certificado e serve em HTTPS sozinho (portas 80 e 443 publicadas).
#
# Várias instâncias da API (Bônus 7.2): `dynamic a` pergunta ao DNS do Docker
# quais contêineres `api` existem agora, então escalar ou reiniciar não exige
# mexer aqui. Se uma instância cai, a requisição é tentada em outra por até 5 s.
{$SITE_ADDRESS::80} {
	encode gzip

	# registro de acesso em JSON na saída do contêiner (docker compose logs web)
	log

	# Tempo real: o WebSocket fica preso a uma instância por natureza. O cookie
	# mantém na mesma instância também quem cair para long-polling, que faz várias
	# requisições por conexão.
	@tempo_real path /socket.io/*
	handle @tempo_real {
		reverse_proxy {
			dynamic a {
				name api
				port 3000
				refresh 5s
			}
			lb_policy cookie instancia
			lb_try_duration 5s
			lb_try_interval 250ms
			fail_duration 10s
		}
	}

	# HTTP comum: qualquer instância serve, em rodízio.
	@api path /api/*
	handle @api {
		reverse_proxy {
			dynamic a {
				name api
				port 3000
				refresh 5s
			}
			lb_policy round_robin
			lb_try_duration 5s
			lb_try_interval 250ms
			fail_duration 10s
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
