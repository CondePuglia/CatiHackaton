{
  "name": "leilao-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "dev:api": "tsx watch src/api.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start:api": "node dist/api.js",
    "start:worker": "node dist/worker.js",
    "seed": "node dist/seed.js",
    "test:unidade": "node --import tsx --test --test-reporter=spec test/unidade/*.test.ts",
    "test:dominio": "node --import tsx --test --test-reporter=spec --test-concurrency=1 test/dominio/*.test.ts",
    "test:sistema": "node --import tsx --test --test-reporter=spec --test-concurrency=1 test/sistema/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/multipart": "^9.0.0",
    "@node-rs/argon2": "^2.0.0",
    "fastify": "^5.0.0",
    "pg": "^8.13.0",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "socket.io-client": "^4.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
