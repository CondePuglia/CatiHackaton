# Copie para .env:   cp .env.example .env
# Os valores abaixo sobem tudo no próprio computador, sem depender de nada externo.
# Para a VM, use .env.vm.example como ponto de partida.

# Sobe também o MinIO (S3 local). Na VM esta linha não existe.
COMPOSE_PROFILES=local

# Porta que o navegador usa.
PORTA_PUBLICA=8080
# Porta do HTTPS. Só responde quando SITE_ADDRESS é um domínio (ver .env.vm.example).
PORTA_HTTPS=8443

# Senha do Postgres (use só letras e números: ela entra em uma URL).
POSTGRES_PASSWORD=leilao

# --- Armazenamento de fotos (RF07) -----------------------------------------
# Local: MinIO, que fala o protocolo S3.
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true
S3_BUCKET=leilao-fotos
S3_CRIAR_BUCKET=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123

# --- Sessão (RF02) -----------------------------------------------------------
SESSAO_INATIVIDADE_SEGUNDOS=7200
SESSAO_MAXIMO_SEGUNDOS=86400
# true quando o site estiver em HTTPS
COOKIE_SEGURO=false

# --- Limites do leilão (RF05 / RF06) ----------------------------------------
# Mudou aqui, vale no próximo "docker compose up -d". A tela lê os mesmos valores.
ANTECEDENCIA_MIN_SEGUNDOS=30
ANTECEDENCIA_MAX_SEGUNDOS=2592000
DURACAO_MIN_SEGUNDOS=60
DURACAO_MAX_SEGUNDOS=604800
FOTOS_MIN=3
FOTOS_MAX=8
FOTO_TAMANHO_MAX_BYTES=5242880

# --- Prorrogação (RF15) ------------------------------------------------------
PRORROGACAO_JANELA_SEGUNDOS=120
PRORROGACAO_MAXIMO_SEGUNDOS=1800

# --- Nível 2 -----------------------------------------------------------------
LANCE_INTERVALO_MIN_MS=500
EDICAO_BLOQUEIO_SEGUNDOS=1800

# --- Operação ----------------------------------------------------------------
WORKER_INTERVALO_MS=500
LOG_LEVEL=info
# Quantas instâncias da API e do worker sobem (Bônus 7.2).
API_REPLICAS=2
WORKER_REPLICAS=1
# Se preenchido, GET /api/metricas exige "Authorization: Bearer <token>".
METRICAS_TOKEN=
