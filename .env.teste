# Ambiente dos testes automatizados (scripts/testar.sh). Não é segredo: tudo local.
# Limites curtos para os testes de sistema não ficarem esperando minutos.
ARQUIVO_ENV=.env.teste
COMPOSE_PROFILES=local
PORTA_PUBLICA=8081
POSTGRES_PASSWORD=leilao

S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true
S3_BUCKET=leilao-fotos
S3_CRIAR_BUCKET=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123

SESSAO_INATIVIDADE_SEGUNDOS=7200
SESSAO_MAXIMO_SEGUNDOS=86400
COOKIE_SEGURO=false

ANTECEDENCIA_MIN_SEGUNDOS=1
ANTECEDENCIA_MAX_SEGUNDOS=2592000
DURACAO_MIN_SEGUNDOS=2
DURACAO_MAX_SEGUNDOS=604800

PRORROGACAO_JANELA_SEGUNDOS=3
PRORROGACAO_MAXIMO_SEGUNDOS=6

LANCE_INTERVALO_MIN_MS=500
EDICAO_BLOQUEIO_SEGUNDOS=5

WORKER_INTERVALO_MS=200
LOG_LEVEL=warn
